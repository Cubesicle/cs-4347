{
    "name": "data-normalization",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/data-normalization/src",
    "tags": ["scope:data", "type:app"],
    "targets": {
        "normalize": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "uv run --project apps/data-normalization python apps/data-normalization/src/main.py",
                "cwd": "{workspaceRoot}"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["production", "^production"],
            "options": {
                "command": "uv run --project apps/data-normalization python -m compileall -q apps/data-normalization/src",
                "cwd": "{workspaceRoot}"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["default", "^production"],
            "options": {
                "command": "uv run --project apps/data-normalization mypy apps/data-normalization/src",
                "cwd": "{workspaceRoot}"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["default", "^production"],
            "options": {
                "command": "uv run pytest",
                "cwd": "apps/data-normalization"
            }
        }
    }
}
