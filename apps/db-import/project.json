{
    "name": "db-import",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/db-import/src",
    "tags": ["scope:data", "type:app"],
    "targets": {
        "import": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "cache": false,
            "options": {
                "command": "node dist/apps/db-import/main.js",
                "cwd": "{workspaceRoot}"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["default", "^production"],
            "options": {
                "command": "tsc --noEmit -p apps/db-import/tsconfig.json",
                "cwd": "{workspaceRoot}"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["default", "^production"],
            "options": {
                "command": "rstest run",
                "cwd": "apps/db-import"
            }
        }
    }
}
