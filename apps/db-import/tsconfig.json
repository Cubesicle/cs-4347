{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "allowJs": true,
        "types": ["bun", "node"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
