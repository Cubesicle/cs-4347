{
    "name": "db-operations",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/db-operations/src",
    "tags": ["scope:shared", "type:data-access"],
    "targets": {
        "typecheck": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["default", "^production"],
            "options": {
                "command": "tsc --noEmit -p packages/db-operations/tsconfig.json",
                "cwd": "{workspaceRoot}"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": ["default", "^production"],
            "options": {
                "command": "rstest run",
                "cwd": "packages/db-operations"
            }
        }
    }
}
