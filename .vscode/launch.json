{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug backend with Nx",
            "program": "${workspaceFolder}/node_modules/.bin/nx",
            "args": ["serve", "backend"],
            "env": {
                "NODE_OPTIONS": "--inspect=9229"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/apps/backend/**/*.(m|c|)js",
                "!**/node_modules/**"
            ]
        }
    ]
}
